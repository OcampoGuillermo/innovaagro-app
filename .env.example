# Copiá este archivo como .env y ajustá los valores antes de publicar.
# `npm start` y `npm run dev` cargan .env automáticamente si existe.

PORT=3000

# Carpeta con la base SQLite y los archivos persistentes.
# En hosting, usá el disco persistente que provea la plataforma.
# DATA_DIR=/var/lib/innovaagro
# Fotos subidas por productores. También debe vivir en el disco persistente.
# UPLOADS_DIR=/var/lib/innovaagro/uploads

# Dejá SEED_DEMO=true mientras probás. Para una instalación real,
# usá SEED_CATALOG=false y SEED_DEMO=false antes del primer arranque.
SEED_CATALOG=true
SEED_DEMO=true

# Con HTTPS (obligatorio en producción).
COOKIE_SECURE=false

# Activar si hay un proxy inverso (Render, Railway, Nginx, etc.).
TRUST_PROXY=false

# NODE_ENV=production

# URL pública real. Necesaria para enlaces de correo y para Mercado Pago.
# En producción debe ser HTTPS, sin barra final.
PUBLIC_URL=https://tu-dominio.example

# Identidad que aparece en los comprobantes internos.
STORE_NAME=InnovaAgro-App
STORE_LEGAL_NAME=InnovaAgro-App
STORE_TAX_ID=
STORE_ADDRESS=Formosa, Argentina
STORE_EMAIL=hola@innovaagro.app
INVOICE_PREFIX=IA

# Cuenta administradora inicial. Se crea o habilita al arrancar.
# La contraseña debe tener 10 caracteres o más y no se guarda en el repositorio.
# Si la cuenta ya era administradora, se conserva su contraseña actual.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo real por SMTP. Si falta SMTP_HOST, los enlaces se escriben en
# DATA_DIR/mail-outbox.jsonl y la app lo informa; no simula entregas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=InnovaAgro-App <no-reply@innovaagro.app>
MAIL_REPLY_TO=hola@innovaagro.app

# Mercado Pago (Checkout Pro). El cobro online queda deshabilitado hasta que
# estén el access token, el secreto del webhook y una PUBLIC_URL HTTPS.
# Usá credenciales de prueba primero y nunca las subas al repositorio.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true

# Notificaciones push. Si no definís las claves, el servidor genera un par
# VAPID y lo guarda en DATA_DIR/vapid.json. En producción podés fijarlas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@innovaagro.app
